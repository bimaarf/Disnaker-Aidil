<!DOCTYPE html>
<html lang="id" data-theme="wireframe">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1" />
    <meta name="robots" content="index, follow" />

    <!-- SEO Meta -->
    <title>Enggang Foundation</title>
    <meta
      name="description"
      content="Enggang Foundation. Pendidikan berkualitas dan pengembangan karakter siswa." />
    <meta
      name="keywords"
      content="Enggang Foundation, pendidikan, sekolah, pendidikan islam, pembelajaran" />
    <meta name="author" content="Enggang Foundation" />

    <!-- Canonical -->
    <link rel="canonical" href="https://enggangfoundation.id" />

    <!-- Favicon -->
    <link
      rel="icon"
      href="https://enggangfoundation.id/api-yz-v1/logo/images/logo.png"
      type="image/png" />
    <link
      rel="apple-touch-icon"
      href="https://enggangfoundation.id/api-yz-v1/logo/images/logo.png" />
    <link
      rel="shortcut icon"
      href="https://enggangfoundation.id/api-yz-v1/logo/images/logo.png"
      type="image/x-icon" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Enggang Foundation" />
    <meta
      property="og:description"
      content="Pendidikan berkualitas dan pengembangan karakter siswa dengan Enggang Foundation." />
    <meta property="og:url" content="https://enggangfoundation.id" />
    <meta
      property="og:image"
      content="https://enggangfoundation.id/api-yz-v1/logo/images/logo.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Enggang Foundation" />
    <meta
      name="twitter:description"
      content="Pendidikan berkualitas dan pengembangan karakter siswa dengan Enggang Foundation." />
    <meta
      name="twitter:image"
      content="https://enggangfoundation.id/api-yz-v1/logo/images/logo.png" />

    <!-- PWA Manifest -->
    <link rel="manifest" href="%PUBLIC_URL%/manifest.json" />

    <!-- Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@300;400;500;700&family=Sofia&display=swap"
      rel="stylesheet" />
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Symbols+Outlined"
      rel="stylesheet" />

    <!-- Tailwind CSS CDN minified + DaisyUI plugin -->
    <script src="https://cdn.tailwindcss.com?plugins=daisyui" defer></script>
    <script>
      tailwind.config = {
        plugins: [require("daisyui")],
        daisyui: {
          themes: [
            {
              wireframe: {
                primary: "#3B82F6",
                "primary-content": "#FFFFFF",
                secondary: "#2563EB",
                "secondary-content": "#FFFFFF",
                accent: "#EC4899",
                "accent-content": "#FFFFFF",
                neutral: "#6B7280",
                "neutral-content": "#FFFFFF",
                "base-100": "#ffffff",
                "base-200": "#f9fafb",
                "base-300": "#e6edf3",
                "base-content": "#1f2937",
                info: "#60A5FA",
                "info-content": "#FFFFFF",
                success: "#10B981",
                "success-content": "#FFFFFF",
                warning: "#F59E0B",
                "warning-content": "#FFFFFF",
                error: "#EF4444",
                "error-content": "#FFFFFF",
